{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "CommonJS",
                            "moduleResolution":  "Node",
                            "lib":  [
                                        "ES2022"
                                    ],
                            "outDir":  "./dist",
                            "strict":  true,
                            "noImplicitAny":  false,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "forceConsistentCasingInFileNames":  true
                        },
    "include":  [
                    "src/**/*",
                    "index.ts"
                ]
}
