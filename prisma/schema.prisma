generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  emailVerified         Boolean                @default(false)
  image                 String?
  role                  String?                @default("user")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  status                String                 @default("ACTIVE")
  bio                   String?
  location              String?
  interests             String[]               @default([])
  coverImage            String?
  accounts              Account[]
  challengeParticipants ChallengeParticipant[]
  challengeSubmissions  ChallengeSubmission[]
  collections           Collection[]
  dailyEntries          DailyEntry[]
  favorites             Favorite[]
  recipes               Recipe[]
  sessions              Session[]
  userBadges            UserBadge[]
  goal                  UserGoal?
  tasteProfile          TasteProfile?
  mealLogs              MealLog[]
  pantryItems           PantryItem[]
  mealProfile           MealProfile?
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String?
  role      String
  content   String
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Recipe {
  id                String             @id @default(cuid())
  mealId            String?            @unique
  title             String
  category          String?
  cuisine           String?
  rating            Float              @default(4.5)
  time              Int                @default(30)
  calories          Int                @default(400)
  image             String?
  instructions      String?
  youtube           String?
  tabType           String             @default("All Recipes")
  createdAt         DateTime           @default(now())
  userId            String?
  sweetness         Int?
  sourness          Int?
  saltiness         Int?
  umami             Int?
  spiciness         Int?
  collectionRecipes CollectionRecipe[]
  favorites         Favorite[]
  ingredients       Ingredient[]
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([rating])
  @@index([time])
}

model Ingredient {
  id       Int     @id @default(autoincrement())
  name     String
  measure  String?
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model Collection {
  id        String             @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes   CollectionRecipe[]

  @@index([userId])
}

model CollectionRecipe {
  id           String     @id @default(cuid())
  collectionId String
  recipeId     String
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([collectionId, recipeId])
  @@index([collectionId])
  @@index([recipeId])
}

model UserGoal {
  id           String   @id @default(cuid())
  userId       String   @unique
  dailyKcal    Int      @default(2000)
  dailyProtein Int      @default(150)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TasteProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  sweetness           Int      @default(5)
  sourness            Int      @default(5)
  saltiness           Int      @default(5)
  umami               Int      @default(5)
  spiciness           Int      @default(5)
  likedIngredients    String[] @default([])
  dislikedIngredients String[] @default([])
  preferredCuisines   String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String
  kcal      Int      @default(0)
  protein   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model MealLog {
  id        String   @id @default(cuid())
  userId    String
  name      String
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  imageUrl  String?
  date      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model CommunityPost {
  id               String          @id @default(cuid())
  authorId         String
  caption          String
  imageUrl         String
  additionalImages Json?
  recipeId         String?
  tags             String[]
  isChallengeEntry Boolean         @default(false)
  challengeName    String?
  isPinned         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sharedFromId     String?
  sharedFrom       CommunityPost?  @relation("CommunityPostShare", fields: [sharedFromId], references: [id])
  shares           CommunityPost[] @relation("CommunityPostShare")

  @@index([authorId, isPinned, createdAt])
  @@index([recipeId])
  @@index([sharedFromId])
  @@index([createdAt])
  @@index([createdAt, id])
  @@index([authorId, createdAt, id])
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([postId, createdAt, id])
  @@index([userId])
  @@index([parentId])
}

model CommunityReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([userId])
}

model CommunityReview {
  id                 String   @id @default(cuid())
  postId             String
  userId             String
  rating             Int
  flavorRating       Int?
  easeRating         Int?
  presentationRating Int?
  comment            String
  cookingTips        String?
  madeItPhoto        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([postId, userId])
  @@index([postId, createdAt, id])
  @@index([userId])
}

model CommunitySavedPost {
  id           String   @id @default(cuid())
  postId       String
  userId       String
  collectionId String?
  createdAt    DateTime @default(now())

  @@unique([postId, userId])
  @@index([collectionId])
}

model CommunityCollection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  coverImage  String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CommunityFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model CommunityMadeIt {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model CommunityStory {
  id        String   @id @default(cuid())
  authorId  String
  imageUrl  String
  caption   String
  tag       String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model CommunityStoryView {
  id       String   @id @default(cuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId, viewedAt])
  @@index([viewerId])
}

model CommunityConversation {
  id        String   @id @default(cuid())
  pairKey   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model CommunityMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  recipientId    String
  text           String
  attachedPostId String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([recipientId, createdAt])
}

model CommunityReport {
  id         String   @id @default(cuid())
  postId     String
  reporterId String
  reason     String
  details    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

model CommunityNotification {
  id           String   @id @default(cuid())
  userId       String
  actorId      String
  type         String
  text         String
  targetPostId String?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, read, createdAt])
}

model PantryRecipe {
  id              String   @id @default(uuid())
  title           String
  description     String
  image           String
  time            String
  level           String
  kcal            String
  protein         String
  whyChosen       String
  ingredients     Json
  instructions    Json
  cuisine         String
  mealType        String
  cookingTime     String
  diet            String
  servings        String
  selectedOptions Json
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Challenge {
  id           String                 @id @default(cuid())
  title        String
  description  String
  durationDays Int                    @default(7)
  difficulty   String                 @default("Beginner")
  rewardPoints Int                    @default(100)
  coverImage   String?
  isFeatured   Boolean                @default(false)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  days         ChallengeDay[]
  participants ChallengeParticipant[]
}

model ChallengeDay {
  id          String                @id @default(cuid())
  challengeId String
  dayNumber   Int
  title       String
  description String
  mealId      String?
  recipeName  String?
  challenge   Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submissions ChallengeSubmission[]

  @@unique([challengeId, dayNumber])
  @@index([challengeId])
}

model ChallengeParticipant {
  id                   String    @id @default(cuid())
  challengeId          String
  userId               String
  status               String    @default("ACTIVE")
  joinedAt             DateTime  @default(now())
  completedAt          DateTime?
  progress             Int       @default(0)
  completedDays        Int       @default(0)
  completionPercentage Int       @default(0)
  currentDay           Int       @default(1)
  currentStreak        Int       @default(0)
  lastCompletedAt      DateTime?
  longestStreak        Int       @default(0)
  totalDays            Int       @default(0)
  challenge            Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model ChallengeSubmission {
  id                 String       @id @default(cuid())
  challengeDayId     String
  userId             String
  imageUrl           String
  notes              String?
  aiEstimatedKcal    Int?
  aiEstimatedProtein Int?
  status             String       @default("PENDING")
  submittedAt        DateTime     @default(now())
  challengeDay       ChallengeDay @relation(fields: [challengeDayId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeDayId, userId])
  @@index([userId])
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  iconUrl     String
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model MealProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  foodPreference      String
  favoriteCuisines    String[]
  likedFoods          String[]
  dislikedFoods       String[]
  allergies           String[]
  dietaryRestrictions String[]
  healthGoal          String
  dailyMeals          Int
  cookingTime         String
  mealPreferences     String[]
  dailyCalorieTarget  Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PantryItem {
  id           String   @id @default(cuid())
  userId       String
  name         String
  quantity     Float
  unit         String
  category     String?
  purchaseDate DateTime @default(now())
  expiryDate   DateTime
  status       String   @default("ACTIVE") // ACTIVE, USED, WASTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiryDate])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nutritionist {
  id             String?  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  education      String?
  speciality     String?
  available_time String?
  fees           Decimal? @db.Decimal
  image_url      String?

  @@ignore
}
