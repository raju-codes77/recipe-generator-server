# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# Better Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# App URL (used in email templates)
NEXT_PUBLIC_APP_URL=https://food-canvas.vercel.app

# Email Configuration (Nodemailer — Gmail SMTP example)
# Use a Gmail App Password, NOT your Gmail account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Vercel Cron Security
# Optional secret to secure /api/cron/* endpoints
CRON_SECRET=

# Other API Keys
GROQ_API_KEY_PLATE_AI=
GROQ_MODEL_PLATE_AI=
RECIPE_GROQ_API_KEY=
RECIPE_GEMINI_API_KEY=
GROQ_API_KEY_COMMUNITY=
GROQ_API_KEY_STORY=
GROQ_MODEL_COMMUNITY=
GROQ_MODEL_STORY=
GEMINI_API_KEY_COMMUNITY=
GEMINI_API_KEY_STORY=

# Supabase (for storage)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MEALDB_API_KEY=
